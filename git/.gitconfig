# import local .gitconfig 
[include]
	path = ~/.gitconfig.local
[init]
	defaultBranch = main
[core]
	pager = delta
	editor = nvim
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true # use n and N to move between diff sections
	dark = true
[diff]
    tool = nvim_difftool
[difftool "nvim_difftool"]
    cmd = nvim -c \"packadd nvim.difftool\" -c \"DiffTool $LOCAL $REMOTE\"
[merge]
	conflictstyle = zdiff3
[alias]
	l = log -20 --graph --pretty=format:'%C(yellow)%h%Creset -%C(auto)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit
	logline = log --graph --pretty=format:'%Cyellow%h%Creset -%C(red)%d%Creset %s %Cgreen(%cr) %C(bright blue)<%an>%Creset' --abbrev-commit
	s = status
	a = add
	c = commit
	w = worktree
	amend = commit --amend --no-edit
	pf = push origin --force
	rc = rebase --continue
	wip = commit -m "WIP"
	default-branch = "!git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@'"
	merge-base-origin = "!f() { git merge-base ${1-HEAD} origin/$(git default-branch); };f "
	stack = "!f() { BRANCH=${1-HEAD}; MERGE_BASE=$(git merge-base-origin); git log --decorate-refs=refs/heads --simplify-by-decoration --pretty=format:\"%(decorate:prefix=,suffix=,tag=,separator=%n)\" $MERGE_BASE..$BRANCH; };f "
	push-stack = "!f() { if [ -n \"$1\" ] && [ \"${1#-}\" = \"$1\" ]; then BRANCH=\"$1\"; shift; else BRANCH=\"HEAD\"; fi; git stack $BRANCH | xargs -I {} git push --force-with-lease \"$@\" origin {}; };f "
[pager]
	log = true
[pull]
	rebase = true
[rebase]
	autosquash = true
	autoStash = true
	updateRefs = true
[color]
	ui = true
[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
