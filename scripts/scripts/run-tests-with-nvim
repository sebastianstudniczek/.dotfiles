#!/bin/sh

# Run tests inside neovim via DotnetTestTraitor plugin instead of console
#
# Usage: bash .husky/nvim/run-tests [FILTER]
#   FILTER: Optional dotnet test filter (e.g., "/*/*/*/*[(Category!=Manual)]")
#
# Requirements:
#   - Neovim must be running with DotnetTestTraitor plugin loaded
#   - .nvim.server file is created by neovim and contains the server socket path

set -e # Exit on any error

FILTER="${1:-}"

if [ ! -f .nvim.server ]; then
	echo "Error: .nvim.server not found. Is Neovim running with DotnetTestTraitor plugin?" >&2
	exit 1
fi

SERVER=$(cat .nvim.server)

if [ -z "$SERVER" ]; then
	echo "Error: .nvim.server is empty" >&2
	exit 1
fi

# Create a temporary file to receive the exit code from Neovim
RESULT_FILE=$(mktemp)

# Clean up temp file automatically if the script is interrupted
trap 'rm -f "$RESULT_FILE"' EXIT

# Verify nvim command exists
# if ! command -v nvim &> /dev/null; then
# 	echo "Error: nvim command not found. Please install Neovim." >&2
# 	exit 1
# fi

# Send test command to neovim
# Note: DotnetTestTraitorRun command expects the filter as an argument
nvim --headless --server "$SERVER" --remote-expr "v:lua.require('dotnet-test-traitor.run')({ 'value': '$FILTER' }, '$RESULT_FILE')" >/dev/null

# Wait until Neovim writes an exit code into RESULT_FILE
while [ ! -s "$RESULT_FILE" ]; do
	sleep 0.2
done

# Read the exit status and exit with it
EXIT_CODE=$(cat "$RESULT_FILE")
exit "$EXIT_CODE"
